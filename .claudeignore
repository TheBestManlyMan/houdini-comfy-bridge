# .claudeignore - Files to exclude from Claude context

# HDA backups (auto-generated by Houdini)
otls/backup/
*.hda.bak*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Test output
.pytest_cache/
htmlcov/
.coverage
*.cover

# Temporary files
/tmp/
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# Debug output
/tmp/workflow_debug.json
/tmp/comfyui_payload_debug.json
*.log

# Output directories
comfyui_output/
output/

# Build artifacts
build/
dist/
*.egg-info/

# IDE files
.vscode/
.idea/
*.sublime-*

# Environment files (may contain secrets)
.env
.env.local
*.key
credentials.json

# Large binary files
*.hda (except otls/comfyui_bridge.hda)
*.hip
*.hipnc
*.hiplc

# Generated documentation
docs/_build/
site/

# Keep only production HDA, ignore development versions
!otls/comfyui_bridge.hda
